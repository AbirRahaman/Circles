# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Every time in the app is shown in this zone, and every time typed into a
# date field is read as this zone. An IANA name, not an abbreviation, so
# daylight saving is handled. Defaults to America/New_York.
NEXT_PUBLIC_GROUP_TIMEZONE=America/New_York

# Splitwise — https://secure.splitwise.com/apps (register an app, redirect
# URI http://localhost:3000/api/splitwise/callback). Not needed to run the app.
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=

# Used to encrypt stored Splitwise tokens. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Protects the album-reminder cron route. openssl rand -hex 16
CRON_SECRET=

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
